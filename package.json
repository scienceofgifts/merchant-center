{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "TEST_MODE=true tsx tests/attributeCorrection.test.ts && TEST_MODE=true tsx tests/websiteFeedSync.test.ts && TEST_MODE=true tsx tests/csvImport.test.ts && TEST_MODE=true tsx tests/cloudflareWorkerD1.test.ts",
    "cf:d1:create": "wrangler d1 create science-of-gifts-merchant-feed-db",
    "cf:d1:migrate:local": "wrangler d1 migrations apply science-of-gifts-merchant-feed-db --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply science-of-gifts-merchant-feed-db --remote",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
