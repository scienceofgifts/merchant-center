# ==============================================================================
# Science of Gifts Merchant Feed Optimizer — Environment Variables Template
# ==============================================================================
# NOTE: Never commit real API keys or tokens to version control.
# In Cloudflare production, set secrets via Wrangler CLI:
#   npx wrangler secret put GEMINI_API_KEY
#   npx wrangler secret put ADMIN_API_TOKEN
#   npx wrangler secret put CF_ACCESS_AUD
#   npx wrangler secret put CF_ACCESS_TEAM_DOMAIN
# ==============================================================================

# Server-side Gemini API key (accessed via env.GEMINI_API_KEY in worker.ts)
GEMINI_API_KEY=

# Optional Cloudflare Access Zero Trust JWT verification settings for production
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional shared bearer token for API authentication (Authorization: Bearer <token>)
ADMIN_API_TOKEN=

# Set to "true" to enforce authentication in local/staging environments
REQUIRE_AUTH=false
